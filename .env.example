# Local blockchain only. Never put a real wallet key in this file.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Filled after local deployment in later phases.
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_VOTING_ADDRESS=
NEXT_PUBLIC_COMPATIBILITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_MOCK_VND_ADDRESS=
NEXT_PUBLIC_ENTITLEMENT_ADDRESS=
NEXT_PUBLIC_PRIMARY_AUCTION_ADDRESS=
NEXT_PUBLIC_SECONDARY_MARKETPLACE_ADDRESS=

# Kat owns the mock storage and mock game adapter implementation.
MOCK_STORAGE_PATH=./data
MOCK_GAME_API_URL=http://localhost:3000/api/game

# Public Sepolia deployment. Use a dedicated test-only wallet.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Optional actor separation. Defaults to the deployer address when omitted.
SEPOLIA_ARTIST_ADDRESS=
SEPOLIA_VERIFIER_ADDRESS=
SEPOLIA_PUBLISHER_ADDRESS=
SEPOLIA_GAME_DEVELOPER_ADDRESS=
SEPOLIA_FAN_ADDRESS=
SEPOLIA_FAN_B_ADDRESS=
SEPOLIA_BUYER_A_ADDRESS=
SEPOLIA_BUYER_B_ADDRESS=
SEPOLIA_BUYER_C_ADDRESS=
SEPOLIA_PUBLISHER_TREASURY_ADDRESS=
SEPOLIA_MARKETPLACE_TREASURY_ADDRESS=
SEPOLIA_DEMO_WALLET_ADDRESS=

# Filled automatically from deployments/sepolia.json after deployment.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEPOLIA_VOTING_ADDRESS=
NEXT_PUBLIC_SEPOLIA_COMPATIBILITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEPOLIA_MOCK_VND_ADDRESS=
NEXT_PUBLIC_SEPOLIA_ENTITLEMENT_ADDRESS=
NEXT_PUBLIC_SEPOLIA_PRIMARY_AUCTION_ADDRESS=
NEXT_PUBLIC_SEPOLIA_SECONDARY_MARKETPLACE_ADDRESS=

# Optional production services. Every integration has a local fallback.
DATABASE_URL=
IPFS_PINNING_URL=
IPFS_PINNING_TOKEN=
INDEXER_CONFIRMATIONS=6
